{
  "name": "venelin-ca",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "pnpm run build-dictionary && next dev -p 3008",
    "build": "pnpm run clean && pnpm run build-dictionary && next build",
