    "date-fns-tz": "^3.2.0",
    "gsap": "^3.14.2",
    "next": "^16.2.2",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.4",
    "react-awesome-reveal": "^4.3.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@contentful/rich-text-react-renderer": "^16.2.0",
    "@netlify/plugin-nextjs": "^5.15.9",
    "@storybook/addon-docs": "^10.3.5",
